{
  "rewrites": [{ "source": "/((?!assets/|brand/|version\\.json).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/version.json", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/((?!assets/|version\\.json).*)", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] }
  ]
}
